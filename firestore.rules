rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {
    match /metrics/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /deployments/{doc} {
      allow read, write: if request.auth != null
                         && request.auth.token.admin == true;
    }
    match /configs/{doc} {
      allow read, write: if request.auth != null
                         && request.auth.token.admin == true;
    }
    match /logs/{doc} {
      allow read, write: if request.auth != null
                         && request.auth.token.admin == true;
    }
  }
}
