    },
    {
      "page": "/tools/[slug]",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "dataRouteRegex": "^/_next/data/cUVnoG2\\-M6aVpoGhh3Lqj/tools/([^/]+?)\\.json$",
      "namedDataRouteRegex": "^/_next/data/cUVnoG2\\-M6aVpoGhh3Lqj/tools/(?<nxtPslug>[^/]+?)\\.json$"
